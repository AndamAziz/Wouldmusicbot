# Copy to .env on the VPS (install.sh does it for you). NEVER commit .env.
BOT_TOKEN=
API_ID=
API_HASH=
# your Telegram user id (for /stats); optional
ADMIN_ID=
# limits (so the VPS is never overloaded)
MAX_CONCURRENT=2
PER_USER_HOUR=20
MAX_AUDIO_MIN=120
MAX_VIDEO_MIN=60
MAX_MB=1900
# optional: YouTube cookies (Netscape format) if YouTube asks "Sign in to confirm you're not a bot"
# COOKIES_FILE=/opt/wouldmusic-bot/data/cookies.txt
